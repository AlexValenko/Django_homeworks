# Создайте файл .env из копии этого файла и замените значения переменных реальными данными
# Секретный ключ для настроек проекта Django
SECRET_KEY=paste_your_key_here

DEBUG=true/false

NAME=db_name
USER=user_name
PASSWORD=your_password
HOST=host_name
PORT=your_port


EMAIL_HOST_USER=your_mail@example.com
EMAIL_HOST_PASSWORD=paste_your_app_password_here